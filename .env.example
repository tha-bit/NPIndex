# Public frontend configuration. VITE_* values are embedded in the browser build.
VITE_MIGRATION_API_URL=https://your-admin-api.onrender.com

# Server-only configuration. Never expose the database URL through a VITE_* variable.
NPINDEX_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
NPINDEX_ADMIN_EMAILS=admin@example.com
NPINDEX_ADMIN_ORIGINS=https://your-project.vercel.app
NPINDEX_MAX_UPLOAD_BYTES=26214400
